#!/bin/sh
# Daily vulnerability scan of every image a running container uses, run as a long-lived container
# on each Docker host. The same script everywhere; everything host-specific comes in through the
# environment.
#
# What it reports, and why so little: a plain "fixable HIGH/CRITICAL" list was a few thousand lines
# on the 2026-10-21 one-off scan, most of it Go stdlib CVEs in helper binaries (gosu in every
# postgres/mysql image) that only an upstream rebuild can fix. So:
#   - only fixable findings (--ignore-unfixed), only HIGH and CRITICAL;
#   - gosu skipped outright (SKIP_FILES), and HIGH findings in Go's stdlib dropped (CRITICAL kept);
#   - kernel header packages (linux-libc-dev, linux-headers-*) dropped: in an image they are only
#     headers, the kernel is the host's. Their kernel CVEs matched KEV on the first test run;
#   - images matching exceptions.txt are scanned and kept in state but left out of the digest.
#
# Teams only hears about what asks for a decision. A new fixable CVE in an upstream image doesn't:
# the fix is the upstream rebuild, which auto-update already pulls. Until 2026-10-30 every new
# finding went to Teams daily and went unread, so now:
#   - daily, only a finding whose CVE is on CISA's Known Exploited Vulnerabilities list (KEV),
#     once per finding, excepted images included: someone is using it, so for an image reachable
#     from outside, stopping the container until upstream ships the fix is on the table. A CVE
#     added to KEV later alerts then. The feed is cached in state; the run fails the healthchecks
#     check once the cache is older than KEV_MAX_AGE days;
#   - weekly, the digest (below).
# History lives in the container log, not in Teams: every new finding is logged as NEW, every one
# that disappeared (image fixed upstream, or container removed) as RESOLVED with the date it was
# first seen, which state keeps per finding. `docker logs trivy-watch | grep RESOLVED`.
#
# Weekly digest (DIGEST_DAY, after the scan), each line a decision:
#   - images with findings first seen more than OVERDUE_DAYS ago: a fix exists (only fixable
#     findings are tracked) and the image still carries it, so upstream isn't shipping it or the
#     update path is broken. Update or replace the image, or add an exception. One line per image
#     with counts, not one per CVE, so the message never needs truncating;
#   - running images built more than STALE_DAYS ago or on an end-of-life OS -- the "maintainer
#     stopped rebuilding" signal that a CVE diff can't give;
#   - exceptions past their review date, and whether this Trivy is behind upstream (take releases
#     at least two weeks old: its own release pipeline was compromised in early 2026).
#
# Known blind spot: images built on the official php images get PHP compiled from source, so
# Trivy never sees a PHP version there. That's what the advisory feed is for.
#
# healthchecks.io: /start before, success after, /fail with the reason when a scan failed or Teams
# didn't accept the message. A dead scanner looks exactly like a clean fleet otherwise.
#
# Busybox sh (the Trivy image is Alpine): no arrays, no [[ ]]. curl, jq and tzdata are installed at
# container start (not per run) unless the image already has them: the Trivy image has none, Docker's
# API needs a unix socket, and without tzdata TZ is silently ignored and RUN_AT means UTC.
#
# SOCK is the Docker API socket for the script's own calls, and Trivy gets the same one through
# DOCKER_HOST unless that is set separately. Pointing SOCK at a filtering proxy works as long as it
# allows what the script and Trivy call: containers/json, containers/{id}/json, and per image
# (always addressed by ID) images/{id}/json, images/{id}/history and images/get?names={id}.
set -u

HOST_LABEL=${HOST_LABEL:?set HOST_LABEL}
RUN_AT=${RUN_AT:-05:00}
DIGEST_DAY=${DIGEST_DAY:-1}          # date +%u, 1 = Monday
STALE_DAYS=${STALE_DAYS:-60}
DRY_RUN=${DRY_RUN:-0}                # 1: print what would be sent, send nothing, ping nothing
RUN_ON_START=${RUN_ON_START:-0}      # 1: run once immediately, then follow the schedule
ONESHOT=${ONESHOT:-0}                # 1: run once and exit (testing)
FORCE_DIGEST=${FORCE_DIGEST:-0}      # 1: send the digest on every run (testing)
SKIP_FILES=${SKIP_FILES:-/usr/local/bin/gosu /usr/sbin/gosu /usr/bin/gosu}
OVERDUE_DAYS=${OVERDUE_DAYS:-30}     # digest: findings open longer than this
KEV_URL=${KEV_URL-https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json}
KEV_MAX_AGE=${KEV_MAX_AGE:-3}        # days a cached KEV feed may be used when the download fails
TEAMS_WEBHOOK_URL=${TEAMS_WEBHOOK_URL:-}
HC_PING_URL=${HC_PING_URL:-}
ADVISORY_HEARTBEAT=${ADVISORY_HEARTBEAT:-}   # advisory-watch.sh's last-ok file, where it runs
EXCEPTIONS=${EXCEPTIONS:-/etc/trivy-watch/exceptions.txt}
STATE=${STATE:-/state}                # findings, Trivy's DB and cache
SOCK=${SOCK:-/var/run/docker.sock}
export DOCKER_HOST="${DOCKER_HOST:-unix://$SOCK}"

log() { echo "$(date '+%Y-%m-%dT%H:%M:%S%z') $*"; }

trap 'exit 0' TERM INT

if ! command -v curl >/dev/null || ! command -v jq >/dev/null || [ ! -d /usr/share/zoneinfo ]; then
    until apk add -q --no-cache curl jq tzdata >/dev/null 2>&1; do
        log "apk add curl jq tzdata failed, retrying in 5 minutes"
        sleep 300 & wait $!
    done
fi
mkdir -p "$STATE/cache" "$STATE/run"

hc() {  # hc <suffix> [body]
    [ -n "$HC_PING_URL" ] && [ "$DRY_RUN" != 1 ] || return 0
    curl -fsS -m 10 --retry 3 -o /dev/null --data-raw "${2:-}" "$HC_PING_URL$1" \
        || log "healthchecks ping $1 failed"
}

# teams <title> <markdown file>; returns non-zero if Teams didn't take it.
teams() {
    if [ "$DRY_RUN" = 1 ] || [ -z "$TEAMS_WEBHOOK_URL" ]; then
        log "TEAMS (not sent): $1"; sed 's/^/    /' "$2"; return 0
    fi
    jq -n --arg title "$1" --rawfile body "$2" '{
        type: "message",
        attachments: [{
            contentType: "application/vnd.microsoft.card.adaptive",
            content: {
                "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                type: "AdaptiveCard", version: "1.4", msteams: {width: "Full"},
                body: [
                    {type: "TextBlock", text: $title, weight: "Bolder", size: "Medium", wrap: true},
                    {type: "TextBlock", text: $body, wrap: true}
                ]
            }
        }]
    }' | curl -fsS -m 30 --retry 3 -o /dev/null -H 'Content-Type: application/json' \
        --data-binary @- "$TEAMS_WEBHOOK_URL"
}

# Prints the exception line matching image reference $1 (shell glob in column 1), if any.
exception_for() {
    [ -f "$EXCEPTIONS" ] || return 0
    grep -v '^[[:space:]]*\(#\|$\)' "$EXCEPTIONS" | while read -r pat review reason; do
        # shellcheck disable=SC2254
        case "$1" in $pat) echo "$pat $review $reason"; break ;; esac
    done
}

scan() {
    R="$STATE/run"
    rm -f "$R"/*
    fails=""
    SCAN_ERR="" SCAN_FATAL=0

    # container name, configured image reference, image id. Config.Image rather than the list's
    # Image field, which degrades to the bare id once the tag has moved on to a newer pull.
    if ! curl -fsS --unix-socket "$SOCK" 'http://d/containers/json' >"$R/ps.json"; then
        SCAN_ERR="docker API unreachable" SCAN_FATAL=1; return 1
    fi
    for id in $(jq -r '.[].Id' "$R/ps.json"); do
        curl -fsS --unix-socket "$SOCK" "http://d/containers/$id/json" \
            | jq -r '[(.Name | ltrimstr("/")), .Config.Image, .Image] | @tsv'
    done >"$R/containers.tsv"

    skip=""
    for f in $SKIP_FILES; do skip="$skip --skip-files $f"; done

    for iid in $(cut -f3 "$R/containers.tsv" | sort -u); do
        ref=$(awk -F'\t' -v i="$iid" '$3 == i { print $2; exit }' "$R/containers.tsv")
        names=$(awk -F'\t' -v i="$iid" '$3 == i { printf "%s%s", s, $1; s = "," }' "$R/containers.tsv")
        short=$(echo "$iid" | cut -c8-19)
        # shellcheck disable=SC2086
        if ! trivy image --quiet --cache-dir "$STATE/cache" --scanners vuln --image-src docker \
                --ignore-unfixed --severity HIGH,CRITICAL $skip --timeout 20m \
                --format json --output "$R/$short.json" "$iid" >"$R/$short.err" 2>&1; then
            log "scan failed: $ref ($short): $(tail -c 300 "$R/$short.err")"
            fails="$fails $ref"
            printf '%s\n' "$ref" >>"$R/failed.txt"
            continue
        fi
        exc=$(exception_for "$ref")
        # One line per finding: key (ref|id|pkg), severity, installed, fixed, title, excepted;
        # report() adds column 7, the date the finding was first seen.
        jq -r --arg ref "$ref" --arg exc "${exc:+1}" '
            [.Results[]? | .Vulnerabilities[]?
             | select(.Severity == "CRITICAL" or .PkgName != "stdlib")
             | select(.PkgName | test("^linux-(libc-dev|headers)") | not)]
            | unique_by(.VulnerabilityID + "|" + .PkgName)[]
            | [$ref + "|" + .VulnerabilityID + "|" + .PkgName, .Severity, .InstalledVersion,
               .FixedVersion, ((.Title // "") | .[0:90]), $exc]
            | @tsv' "$R/$short.json" >>"$R/findings.tsv"
        # Image facts for the digest: ref, containers, build date, age in days, OS, EOL flag.
        jq -r --arg ref "$ref" --arg names "$names" '
            (.Metadata.ImageConfig.created // "") as $c
            | ($c | sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | try fromdateiso8601 catch null) as $t
            | [$ref, $names, ($c | .[0:10]),
               (if $t == null or $t < 86400 then "?" else ((now - $t) / 86400 | floor | tostring) end),
               ((.Metadata.OS.Family // "-") + " " + (.Metadata.OS.Name // "")),
               (if .Metadata.OS.EOSL then "EOL" else "" end)]
            | @tsv' "$R/$short.json" >>"$R/images.tsv"
    done
    touch "$R/findings.tsv" "$R/images.tsv"
    sort -u -o "$R/findings.tsv" "$R/findings.tsv"
    [ -z "$fails" ] || { SCAN_ERR="scan failed for:$fails"; return 1; }
}

report() {
    R="$STATE/run"
    first=0
    [ -f "$STATE/findings.tsv" ] || { first=1; : >"$STATE/findings.tsv"; }

    # Findings of an image whose scan failed this time are carried over from the previous state,
    # so they neither "resolve" now nor re-alert on the next good run.
    if [ -f "$R/failed.txt" ]; then
        awk -F'\t' 'FILENAME == ARGV[1] { f[$0]; next } { split($1, k, "|"); if (k[1] in f) print }' \
            "$R/failed.txt" "$STATE/findings.tsv" >>"$R/findings.tsv"
        sort -u -o "$R/findings.tsv" "$R/findings.tsv"
    fi

    # First-seen date (column 7), carried over from the previous state; today for anything new.
    # State written before this column existed (2026-10-22) gets its own file date: the finding
    # was open at least since then, and the baseline was only a day earlier.
    today=$(date +%Y-%m-%d)
    prev=$(date -r "$STATE/findings.tsv" +%Y-%m-%d)
    awk -F'\t' -v OFS='\t' -v today="$today" -v prev="$prev" '
        FILENAME == ARGV[1] { fs[$1] = ($7 != "" ? $7 : prev); next }
        { $7 = ($1 in fs ? fs[$1] : today); print }' \
        "$STATE/findings.tsv" "$R/findings.tsv" >"$R/findings.dated"
    mv "$R/findings.dated" "$R/findings.tsv"

    awk -F'\t' 'FILENAME == ARGV[1] { seen[$1]; next } !($1 in seen) && $6 != "1"' \
        "$STATE/findings.tsv" "$R/findings.tsv" >"$R/new.tsv"
    # Gone since the previous run: fixed by an image update, or the container was removed. Logged
    # only, so `docker logs trivy-watch | grep RESOLVED` is the history of fixes.
    awk -F'\t' 'FILENAME == ARGV[1] { cur[$1]; next } !($1 in cur)' \
        "$R/findings.tsv" "$STATE/findings.tsv" >"$R/resolved.tsv"
    total=$(wc -l <"$R/findings.tsv")
    new=$(wc -l <"$R/new.tsv")
    resolved=$(wc -l <"$R/resolved.tsv")
    log "$total fixable finding(s) in scope, $new new, $resolved resolved"
    awk -F'\t' -v today="$today" -v prev="$prev" \
        '{ printf "    RESOLVED %s %s (open %s to %s)\n", $2, $1, ($7 != "" ? $7 : prev), today }' \
        "$R/resolved.tsv"

    if [ "$first" = 1 ]; then
        log "first run: baseline of $total finding(s) recorded"
    else
        awk -F'\t' '{ printf "    NEW %s %s %s -> %s: %s\n", $2, $1, $3, $4, $5 }' "$R/new.tsv"
    fi
    cp "$R/findings.tsv" "$STATE/findings.tsv"
}

# Alerts once per finding whose CVE is on CISA's KEV list; returns non-zero if the feed is too old
# or Teams didn't take the alert (KEV_ERR says which). Alerted keys live in $STATE/kev-alerted.txt,
# pruned to the current findings, so a finding that resolves and comes back alerts again.
kev() {
    R="$STATE/run"
    KEV_ERR=""
    [ -n "$KEV_URL" ] || return 0
    if curl -fsS -m 60 --retry 3 "$KEV_URL" | jq -r '.vulnerabilities[].cveID' >"$R/kev.tmp" \
            && [ -s "$R/kev.tmp" ]; then
        mv "$R/kev.tmp" "$STATE/kev.txt"
    else
        log "KEV feed download failed"
        if [ -z "$(find "$STATE/kev.txt" -mtime -"$KEV_MAX_AGE" 2>/dev/null)" ]; then
            KEV_ERR="KEV feed not downloaded for $KEV_MAX_AGE days"; return 1
        fi
    fi
    touch "$STATE/kev-alerted.txt"
    awk -F'\t' 'FILENAME == ARGV[1] { kev[$1]; next } { split($1, k, "|"); if (k[2] in kev) print }' \
        "$STATE/kev.txt" "$STATE/findings.tsv" >"$R/kev-hits.tsv"
    awk -F'\t' 'FILENAME == ARGV[1] { done[$1]; next } !($1 in done)' \
        "$STATE/kev-alerted.txt" "$R/kev-hits.tsv" >"$R/kev-new.tsv"
    n=$(wc -l <"$R/kev-new.tsv")
    if [ "$n" -gt 0 ]; then
        sort -t "$(printf '\t')" -k1,1 "$R/kev-new.tsv" | awk -F'\t' '
            { split($1, k, "|")
              if (k[1] != last) { printf "%s**%s**\n\n", (n++ ? "\n" : ""), k[1]; last = k[1] }
              printf "- %s %s %s %s -> %s: %s%s\n", $2, k[2], k[3], $3, $4, $5,
                  ($6 == "1" ? " (excepted image)" : "") }' >"$R/kev.md"
        awk -F'\t' '{ printf "    KEV %s %s\n", $2, $1 }' "$R/kev-new.tsv"
        if ! teams "Trivy $HOST_LABEL: $n known exploited vulnerabilit$([ "$n" = 1 ] && echo y || echo ies)" \
                "$R/kev.md"; then
            KEV_ERR="Teams did not accept the KEV alert"; return 1
        fi
    fi
    # Only once Teams has the alert, so a failed send is retried on the next run.
    cut -f1 "$R/kev-hits.tsv" | sort -u >"$STATE/kev-alerted.txt"
}

digest() {
    R="$STATE/run"
    today=$(date +%Y-%m-%d)
    cutoff=$(date -d "@$(( $(date +%s) - OVERDUE_DAYS * 86400 ))" +%Y-%m-%d)
    {
        echo "**Fix available for more than $OVERDUE_DAYS days, image still affected**"
        echo
        # Per image: counts, the oldest first-seen date and up to three package names. Containers
        # from this run's images.tsv; excepted images left out.
        awk -F'\t' -v cutoff="$cutoff" '
            FILENAME == ARGV[1] { names[$1] = $2; next }
            $6 != "1" && $7 != "" && $7 < cutoff {
                split($1, k, "|"); i = k[1]
                if (!(i in tot)) order[++n] = i
                tot[i]++; if ($2 == "CRITICAL") crit[i]++
                if (!(i in old) || $7 < old[i]) old[i] = $7
                if (!((i, k[3]) in seen)) { seen[i, k[3]]; np[i]++
                    if (np[i] <= 3) pk[i] = pk[i] (np[i] > 1 ? ", " : "") k[3] }
            }
            END {
                for (j = 1; j <= n; j++) { i = order[j]
                    printf "%d\t- %s (%s): %d CRITICAL, %d HIGH, open since %s; %s%s\n",
                        crit[i] + 0, i, (i in names ? names[i] : "-"), crit[i], tot[i] - crit[i],
                        old[i], pk[i], (np[i] > 3 ? " and " np[i] - 3 " more" : "") }
                if (!n) print "0\t- none"
            }' "$R/images.tsv" "$STATE/findings.tsv" | sort -t "$(printf '\t')" -k1,1nr -k2 | cut -f2-
        echo
        echo "**Images built more than $STALE_DAYS days ago, or on an end-of-life OS**"
        echo
        awk -F'\t' -v d="$STALE_DAYS" '
            ($4 != "?" && $4 + 0 > d) || $6 == "EOL" || $4 == "?" {
                printf "- %s (%s): built %s%s, %s %s\n", $1, $2,
                    ($4 == "?" ? "date unknown" : $3), ($4 == "?" ? "" : ", " $4 " days ago"), $5, $6; n++ }
            END { if (!n) print "- none" }' "$R/images.tsv"
        echo
        echo "**Exceptions due for review**"
        echo
        if [ -f "$EXCEPTIONS" ]; then
            grep -v '^[[:space:]]*\(#\|$\)' "$EXCEPTIONS" | while read -r pat review reason; do
                [ "$(echo "$review" | tr -d -)" -le "$(echo "$today" | tr -d -)" ] 2>/dev/null \
                    && echo "- $pat (review $review): $reason"
            done
        fi | grep . || echo "- none"
        echo
        echo "**Totals**"
        echo
        awk -F'\t' '{ split($1, k, "|"); c[$2]++; if ($6 == "1") e++; if (!(k[1] in img)) { img[k[1]]; n++ } }
            END { printf "- %d CRITICAL, %d HIGH fixable across %d image(s), %d of them in excepted images\n",
                  c["CRITICAL"], c["HIGH"], n, e }' "$STATE/findings.tsv"
        mine=$(trivy --version 2>/dev/null | awk '/^Version:/ { print $2; exit }')
        latest=$(curl -fsS -m 20 https://api.github.com/repos/aquasecurity/trivy/releases/latest \
                 | jq -r '.tag_name + " " + (.published_at | .[0:10])' 2>/dev/null)
        echo "- Trivy here: $mine; latest upstream: ${latest:-unknown} (take releases two weeks old or more)"
    } >"$R/digest.md"
    teams "Trivy $HOST_LABEL: weekly digest" "$R/digest.md"
}

run_once() {
    log "scan starting"
    hc /start
    err=""
    scan || err=$SCAN_ERR
    # Without a container list there is nothing to compare: reporting would "resolve" everything.
    if [ "$SCAN_FATAL" = 0 ]; then
        report
        kev || err="${err:+$err; }$KEV_ERR"
    fi
    if [ "$SCAN_FATAL" = 0 ] && { [ "$(date +%u)" = "$DIGEST_DAY" ] || [ "$FORCE_DIGEST" = 1 ]; }; then
        digest || err="${err:+$err; }Teams did not accept the digest"
    fi
    # advisory-watch.sh has no healthchecks.io check of its own; this one vouches for it.
    if [ -n "$ADVISORY_HEARTBEAT" ] && [ -z "$(find "$ADVISORY_HEARTBEAT" -mmin -360 2>/dev/null)" ]; then
        err="${err:+$err; }advisory-watch has not completed a round in 6 hours"
    fi
    if [ -n "$err" ]; then
        log "run finished with problems: $err"
        hc /fail "$err"
    else
        log "run finished"
        hc "" "$(wc -l <"$STATE/findings.tsv") findings in scope"
    fi
}

log "trivy-watch on $HOST_LABEL: daily at $RUN_AT, digest on day $DIGEST_DAY, dry run $DRY_RUN"
[ "$RUN_ON_START" = 1 ] || [ "$ONESHOT" = 1 ] && run_once
[ "$ONESHOT" = 1 ] && exit 0

while :; do
    now=$(date +%s)
    next=$(date -d "$(date +%Y-%m-%d) $RUN_AT" +%s)
    [ "$next" -gt "$now" ] || next=$((next + 86400))
    sleep $((next - now)) & wait $!
    run_once
done
