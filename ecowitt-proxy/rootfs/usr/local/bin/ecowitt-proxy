#!/usr/bin/env python3
"""Receives an Ecowitt station's "customized" uploads over plain HTTP and forwards them, unchanged,
to the Ecowitt integration's webhook in Home Assistant.

Ecowitt consoles can only send plain HTTP; a Home Assistant that only serves HTTPS can't take
them directly. Supervisor's internal API (http://supervisor/core) can, with this add-on's
SUPERVISOR_TOKEN.

Python standard library only: no pip packages to fall behind on CVEs.
"""

import json
import logging
import os
import signal
import sys
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

OPTIONS_FILE = os.environ.get("OPTIONS_FILE", "/data/options.json")
# Overridable for tests; inside Supervisor the default is the only sensible value.
WEBHOOK_BASE = os.environ.get("WEBHOOK_BASE", "http://supervisor/core/api/webhook/")
LISTEN_PORT = int(os.environ.get("LISTEN_PORT", "8080"))
SUMMARY_INTERVAL = float(os.environ.get("SUMMARY_INTERVAL", "3600"))
CHECK_INTERVAL = float(os.environ.get("CHECK_INTERVAL", "30"))
UPLOAD_PATH = "/log/ha"
MAX_BODY = 64 * 1024  # a full station upload is about 1 KiB
FORWARD_TIMEOUT = 10
NOBODY = 65534

log = logging.getLogger("ecowitt-proxy")


class Forwarder:
    """Forwards a body to the webhook. Returns None when Home Assistant took it, otherwise why not;
    logging is left to Activity."""

    def __init__(self, url, token):
        self.url = url
        self.token = token

    def forward(self, body, content_type):
        request = urllib.request.Request(self.url, data=body, method="POST")
        request.add_header("Content-Type", content_type)
        if self.token:
            request.add_header("Authorization", f"Bearer {self.token}")
        try:
            with urllib.request.urlopen(request, timeout=FORWARD_TIMEOUT) as response:
                response.read()
                status = response.status
        except urllib.error.HTTPError as err:
            return f"Home Assistant answered HTTP {err.code}"
        except (urllib.error.URLError, OSError) as err:
            return f"Home Assistant unreachable: {getattr(err, 'reason', err)}"
        return None if status == 200 else f"Home Assistant answered HTTP {status}"


def duration(seconds):
    seconds = int(round(seconds))
    if seconds < 120:
        value, unit = seconds, "second"
    elif seconds < 7200:
        value, unit = seconds // 60, "minute"
    else:
        value, unit = seconds // 3600, "hour"
    return f"{value} {unit}" if value == 1 else f"{value} {unit}s"


class Activity:
    """What reaches the log at INFO and above, so a healthy station doesn't write a line a minute:
    the first upload after start, changes between forwarding working and failing, a summary every
    SUMMARY_INTERVAL, and a warning when the station goes quiet (and when it's back)."""

    def __init__(self, stale_after, summary_every, clock=time.monotonic):
        self.lock = threading.Lock()
        self.clock = clock
        self.stale_after = stale_after
        self.summary_every = summary_every
        self.started = self.window_start = clock()
        self.last_upload = None
        self.quiet_warned = False
        self.forwarding_ok = None
        self.forwarded = self.failed = 0
        self.senders = set()

    def record(self, sender, error):
        with self.lock:
            now = self.clock()
            if self.quiet_warned:
                log.info("Uploads resumed after %s", duration(now - (self.last_upload or self.started)))
                self.quiet_warned = False
            first = self.last_upload is None
            self.last_upload = now
            self.senders.add(sender)
            if error is None:
                self.forwarded += 1
            else:
                self.failed += 1

            if first and error is None:
                log.info("First upload since start, from %s: forwarded to Home Assistant", sender)
            elif first:
                log.error("First upload since start, from %s: not forwarded (%s)", sender, error)
            elif error is None and self.forwarding_ok is False:
                log.info("Forwarding to Home Assistant works again")
            elif error is not None and self.forwarding_ok is not False:
                log.error("Forwarding is failing: %s", error)
            elif error is not None:
                log.debug("Still failing: %s", error)
            self.forwarding_ok = error is None

    def tick(self):
        with self.lock:
            now = self.clock()
            quiet = now - (self.last_upload or self.started)
            if self.stale_after and not self.quiet_warned and quiet >= self.stale_after:
                if self.last_upload is None:
                    log.warning("No upload in the %s since start; check the station's customized "
                                "upload settings", duration(quiet))
                else:
                    log.warning("No upload for %s; check the station", duration(quiet))
                self.quiet_warned = True
            if now - self.window_start >= self.summary_every:
                self._summary(now)

    def _summary(self, now):
        span = now - self.window_start
        label = "Last hour" if abs(span - 3600) < 60 else f"Last {duration(span)}"
        total = self.forwarded + self.failed
        if total == 0:
            log.info("%s: no uploads", label)
        else:
            senders = ", ".join(sorted(self.senders))
            result = "all forwarded" if self.failed == 0 else (
                f"{self.forwarded} forwarded, {self.failed} not")
            log.info("%s: %d uploads from %s, %s", label, total, senders, result)
        self.window_start = now
        self.forwarded = self.failed = 0
        self.senders = set()

    def watch(self):
        while True:
            time.sleep(CHECK_INTERVAL)
            self.tick()


class Handler(BaseHTTPRequestHandler):
    server_version = "ecowitt-proxy"
    sys_version = ""
    timeout = 15  # per connection, so a stalled client can't hold a thread forever
    forwarder = None  # set in main()
    activity = None

    def do_GET(self):
        if self.path == "/":
            self._reply(200, "Home Assistant Ecowitt proxy\n")
        elif self.path.split("?", 1)[0] == UPLOAD_PATH:
            self._reply(405, "Requires POST\n")
        else:
            self._reply(404, "Not found\n")

    def do_POST(self):
        if self.path.split("?", 1)[0] != UPLOAD_PATH:
            self._reply(404, "Not found\n")
            return
        try:
            length = int(self.headers.get("Content-Length", ""))
        except ValueError:
            self._reply(411, "Content-Length required\n")
            return
        if length < 0 or length > MAX_BODY:
            self._reply(413, "Too large\n")
            return
        body = self.rfile.read(length)
        content_type = self.headers.get("Content-Type", "application/x-www-form-urlencoded")
        log.debug("Upload from %s: %d bytes", self.client_address[0], len(body))
        error = self.forwarder.forward(body, content_type)
        self.activity.record(self.client_address[0], error)
        if error is None:
            self._reply(200, "OK\n")
        else:
            self._reply(502, "Home Assistant did not accept the upload\n")

    def _reply(self, status, text):
        data = text.encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, fmt, *args):
        log.debug("%s %s", self.client_address[0], fmt % args)


def drop_privileges():
    """Runs as nobody once the options are read: nothing after this needs root."""
    if os.getuid() != 0:
        return
    os.setgroups([])
    os.setgid(NOBODY)
    os.setuid(NOBODY)


def main():
    try:
        with open(OPTIONS_FILE, encoding="utf-8") as fh:
            options = json.load(fh)
    except (OSError, ValueError) as err:
        print(f"[ERROR] Can't read {OPTIONS_FILE}: {err}", file=sys.stderr)
        return 1

    level = str(options.get("log_level", "info")).upper()
    logging.basicConfig(
        stream=sys.stdout,
        level=getattr(logging, level, logging.INFO),
        format="%(asctime)s %(levelname)-7s %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
    )

    webhook_id = str(options.get("webhook_id", "")).strip()
    if not webhook_id:
        log.error("webhook_id is not set")
        return 1
    token = os.environ.get("SUPERVISOR_TOKEN", "")
    if not token:
        log.warning("SUPERVISOR_TOKEN is not set; Home Assistant will refuse the uploads")

    try:
        stale_after = float(os.environ.get("STALE_AFTER_SECONDS", "")
                            or 60 * float(options.get("stale_after_minutes", 10)))
    except ValueError:
        log.error("stale_after_minutes is not a number")
        return 1

    Handler.forwarder = Forwarder(WEBHOOK_BASE + webhook_id, token)
    Handler.activity = Activity(stale_after, SUMMARY_INTERVAL)
    server = ThreadingHTTPServer(("", LISTEN_PORT), Handler)
    server.daemon_threads = True
    drop_privileges()
    # As PID 1 (no init) SIGTERM would otherwise be ignored and stopping waits for SIGKILL.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))

    # The webhook ID itself is never logged: anyone who has it can post into the integration.
    log.info("Listening on port %d for uploads to %s", LISTEN_PORT, UPLOAD_PATH)
    if stale_after:
        log.info("Warning when no upload arrives for %s", duration(stale_after))
    threading.Thread(target=Handler.activity.watch, daemon=True).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
